              "responseTime": null,
              "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<element>\n  <ServiceEndpoint>(string)</ServiceEndpoint>\n  <MaxResults>(integer)</MaxResults>\n  <Prefix>(string)</Prefix>\n  <Containers>\n    <Name>(string)</Name>\n    <Properties>\n      <Last-Modified>(string)</Last-Modified>\n      <Etag>(string)</Etag>\n      <LeaseStatus>(string)</LeaseStatus>\n      <LeaseState>(string)</LeaseState>\n      <LeaseDuration>(string)</LeaseDuration>\n      <PublicAccess>(string)</PublicAccess>\n      <HasImmutabilityPolicy>(boolean)</HasImmutabilityPolicy>\n      <HasLegalHold>(boolean)</HasLegalHold>\n      <DefaultEncryptionScope>(string)</DefaultEncryptionScope>\n      <DenyEncryptionScopeOverride>(boolean)</DenyEncryptionScopeOverride>\n      <ImmutableStorageWithVersioningEnabled>(boolean)</ImmutableStorageWithVersioningEnabled>\n    </Properties>\n    <Metadata>\n    </Metadata>\n  </Containers>\n  <Containers>\n    <Name>(string)</Name>\n    <Properties>\n      <Last-Modified>(string)</Last-Modified>\n      <Etag>(string)</Etag>\n      <LeaseStatus>(string)</LeaseStatus>\n      <LeaseState>(string)</LeaseState>\n      <LeaseDuration>(string)</LeaseDuration>\n      <PublicAccess>(string)</PublicAccess>\n      <HasImmutabilityPolicy>(boolean)</HasImmutabilityPolicy>\n      <HasLegalHold>(boolean)</HasLegalHold>\n      <DefaultEncryptionScope>(string)</DefaultEncryptionScope>\n      <DenyEncryptionScopeOverride>(boolean)</DenyEncryptionScopeOverride>\n      <ImmutableStorageWithVersioningEnabled>(boolean)</ImmutableStorageWithVersioningEnabled>\n    </Properties>\n    <Metadata>\n    </Metadata>\n  </Containers>\n  <NextMarker>(string)</NextMarker>\n</element>",
