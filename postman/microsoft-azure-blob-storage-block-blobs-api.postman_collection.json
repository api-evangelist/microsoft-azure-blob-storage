  "info": {
    "_postman_id": "6bb7c5c3-9628-4791-a6da-e934446fb827",
    "name": "Azure Blob Storage REST Append Blobs Block Blobs API",
    "description": "The Azure Blob Storage REST API provides programmatic access to unstructured data storage in Azure. It supports operations on the Blob service, containers, and blobs, including block blobs, append blobs, and page blobs. Blobs can store any type of text or binary data such as documents, media files, and application installers. Blob Storage is optimized for storing massive amounts of unstructured data accessible via HTTP or HTTPS from anywhere in the world.\n\nContact Support:\n Name: Microsoft Azure Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T02:09:47.000Z",
    "updatedAt": "2026-07-28T02:09:47.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-6bb7c5c3-9628-4791-a6da-e934446fb827"
  },
