        {
          "name": "{blob}?comp=block",
          "item": [
            {
              "name": "Azure Blob Storage Put block",
              "id": "5e0f1d70-3e38-44e9-acc8-f1528f933906",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "description": "(Required) Specifies the version of the Azure Storage REST API to use for the request.",
                    "key": "x-ms-version",
                    "value": "2024-11-04"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/octet-stream"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "<binary>"
                },
                "url": {
                  "raw": "{{baseUrl}}/:container/{{blob}}?comp=block&blockid=<string>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    ":container",
                    "{{blob}}"
                  ],
                  "query": [
                    {
                      "key": "comp",
                      "value": "block"
                    },
                    {
                      "description": "(Required) A base64-encoded block ID that identifies the block. All block IDs for a given blob must be the same length.",
                      "key": "blockid",
                      "value": "<string>"
                    }
                  ],
                  "variable": [
                    {
                      "id": "8626fec6-c8e7-4015-b293-5b960212c21b",
                      "key": "container",
                      "value": "d1e506sz257vm2-mervtq5lxh32",
                      "description": "(Required) The container name. Must be a valid DNS name, 3 to 63 characters, starting with a letter or number, and containing only lowercase letters, numbers, and hyphens."
                    }
                  ]
                },
                "description": "Uploads a block to be committed as part of a block blob. Each block can be up to 4000 MiB in size. The block is identified by a base64-encoded block ID. Blocks must be committed using Put Block List to form the final blob."
              },
              "response": [
                {
                  "id": "5248b79b-3867-465c-a5d5-ed5929501a71",
                  "name": "Block uploaded successfully",
