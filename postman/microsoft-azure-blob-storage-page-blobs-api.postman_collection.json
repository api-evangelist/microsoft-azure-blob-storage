          "item": [
            {
              "name": "Azure Blob Storage Put page",
              "id": "7d8474ba-167f-4b3b-aa44-1b18c25e2297",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "description": "(Required) Specifies the version of the Azure Storage REST API to use for the request.",
                    "key": "x-ms-version",
                    "value": "2024-11-04"
                  },
                  {
                    "description": "(Required) The page write operation type.",
                    "key": "x-ms-page-write",
                    "value": "clear"
                  },
                  {
                    "description": "(Required) The byte range for the page write operation. Must be aligned to 512-byte boundaries. Format is bytes=startByte-endByte.",
                    "key": "x-ms-range",
                    "value": "<string>"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/octet-stream"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "<binary>"
                },
                "url": {
                  "raw": "{{baseUrl}}/:container/{{blob}}?comp=page",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    ":container",
                    "{{blob}}"
                  ],
                  "query": [
                    {
                      "key": "comp",
                      "value": "page"
                    }
                  ],
                  "variable": [
                    {
                      "id": "5f7931b8-3c1c-4ede-939c-dfa1ff8c246b",
                      "key": "container",
                      "value": "8scm28bb2oie1kr-ywn-9gonlo83chhf2tynjkqjw4t64u0y",
                      "description": "(Required) The container name. Must be a valid DNS name, 3 to 63 characters, starting with a letter or number, and containing only lowercase letters, numbers, and hyphens."
                    }
                  ]
                },
                "description": "Writes a range of pages to a page blob. Pages must be aligned to 512-byte boundaries. The update action writes data to the blob, and the clear action deallocates the specified pages."
              },
