      "item": [
        {
          "id": "1e251a92-d49d-43f6-8f3a-ace214c636c1",
          "name": "Azure Blob Storage Append block",
          "request": {
            "name": "Azure Blob Storage Append block",
            "description": {
              "content": "Commits a new block of data to the end of an existing append blob. Each block can be up to 4 MiB in size. An append blob can contain up to 50,000 blocks.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":container",
                "{{blob}}"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "comp",
                  "value": "appendblock"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "container",
                  "description": "(Required) The container name. Must be a valid DNS name, 3 to 63 characters, starting with a letter or number, and containing only lowercase letters, numbers, and hyphens."
                },
                {
                  "description": "The name of the Azure Storage account",
                  "type": "any",
                  "value": "{{accountName}}",
                  "key": "accountName"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Specifies the version of the Azure Storage REST API to use for the request.",
                "key": "x-ms-version",
                "value": "2024-11-04"
              },
              {
                "key": "Content-Type",
                "value": "application/octet-stream"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "<binary>"
            }
          },
