        {
          "id": "44f23399-9f3e-4f40-a789-6bdda802b833",
          "name": "Azure Blob Storage Put page",
          "request": {
            "name": "Azure Blob Storage Put page",
            "description": {
              "content": "Writes a range of pages to a page blob. Pages must be aligned to 512-byte boundaries. The update action writes data to the blob, and the clear action deallocates the specified pages.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":container",
                "{{blob}}"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "comp",
                  "value": "page"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "container",
                  "description": "(Required) The container name. Must be a valid DNS name, 3 to 63 characters, starting with a letter or number, and containing only lowercase letters, numbers, and hyphens."
                },
                {
                  "description": "The name of the Azure Storage account",
                  "type": "any",
                  "value": "{{accountName}}",
                  "key": "accountName"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Specifies the version of the Azure Storage REST API to use for the request.",
                "key": "x-ms-version",
                "value": "2024-11-04"
              },
              {
                "disabled": false,
                "description": "(Required) The page write operation type.",
                "key": "x-ms-page-write",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "(Required) The byte range for the page write operation. Must be aligned to 512-byte boundaries. Format is bytes=startByte-endByte.",
                "key": "x-ms-range",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/octet-stream"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "<binary>"
            }
