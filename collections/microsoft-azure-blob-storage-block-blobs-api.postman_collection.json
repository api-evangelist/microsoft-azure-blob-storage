      "item": [
        {
          "id": "c3901e8c-23f6-4efb-b026-6c9b066fc517",
          "name": "Azure Blob Storage Put block",
          "request": {
            "name": "Azure Blob Storage Put block",
            "description": {
              "content": "Uploads a block to be committed as part of a block blob. Each block can be up to 4000 MiB in size. The block is identified by a base64-encoded block ID. Blocks must be committed using Put Block List to form the final blob.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":container",
                "{{blob}}"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "comp",
                  "value": "block"
                },
                {
                  "disabled": false,
                  "key": "blockid",
                  "value": "<string>",
                  "description": "(Required) A base64-encoded block ID that identifies the block. All block IDs for a given blob must be the same length."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "container",
                  "description": "(Required) The container name. Must be a valid DNS name, 3 to 63 characters, starting with a letter or number, and containing only lowercase letters, numbers, and hyphens."
                },
                {
                  "description": "The name of the Azure Storage account",
                  "type": "any",
                  "value": "{{accountName}}",
                  "key": "accountName"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Specifies the version of the Azure Storage REST API to use for the request.",
                "key": "x-ms-version",
                "value": "2024-11-04"
              },
              {
                "key": "Content-Type",
                "value": "application/octet-stream"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "<binary>"
            }
