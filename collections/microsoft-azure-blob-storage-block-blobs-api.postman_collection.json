          "request": {
            "name": "Azure Blob Storage Put block list",
            "description": {
              "content": "Commits a blob by specifying the set of block IDs that comprise the block blob. Blocks can be from the latest uncommitted block list, the committed block list, or both.",
              "type": "text/plain"
